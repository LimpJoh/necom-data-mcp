# ===== Server =====
PORT=3010
# Publik URL bakom Caddy (används som OAuth issuer + resource). Ingen avslutande snedstreck.
PUBLIC_URL=https://mcp.necom.se
# Lösenordet du anger när Claude kopplar upp sig (OAuth-inloggningssidan). Välj långt.
MCP_LOGIN_PASSWORD=byt-mig-till-något-långt
# Var klienter/tokens sparas så att kopplingen överlever omstart. Skapas automatiskt (chmod 600).
MCP_STATE_FILE=./data/oauth-state.json
# Livslängd på access token i sekunder (refresh token roterar automatiskt)
MCP_ACCESS_TOKEN_TTL=3600

# ===== WooCommerce-butiker =====
# Kommaseparerad lista med nycklar. Varje nyckel får egna variabler nedan.
WOO_STORES=outlets,svenskabarr,trailtails,clubwear

WOO_outlets_NAME=Outlets.se
WOO_outlets_URL=https://outlets.se
WOO_outlets_USER=wp-användarnamn
WOO_outlets_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WOO_outlets_GA4_PROPERTY=123456789

WOO_svenskabarr_NAME=Svenska Barr
WOO_svenskabarr_URL=https://svenskabarr.se
WOO_svenskabarr_USER=
WOO_svenskabarr_APP_PASSWORD=
WOO_svenskabarr_GA4_PROPERTY=

WOO_trailtails_NAME=Trail Tails / K9 Biathlon
WOO_trailtails_URL=https://trailtails.se
WOO_trailtails_USER=
WOO_trailtails_APP_PASSWORD=
WOO_trailtails_GA4_PROPERTY=

WOO_clubwear_NAME=Clubwear.se
WOO_clubwear_URL=https://clubwear.se
WOO_clubwear_USER=
WOO_clubwear_APP_PASSWORD=
WOO_clubwear_GA4_PROPERTY=

# ===== Google Analytics 4 =====
# Sökväg till servicekontots JSON-nyckel. Servicekontots e-post måste ha rollen "Läsare" på varje GA4-property.
GOOGLE_APPLICATION_CREDENTIALS=./data/ga4-service-account.json
# Extra GA4-properties som inte hör till en Woo-butik, t.ex. Dogshowpro: nyckel=propertyId,nyckel=propertyId
GA4_EXTRA_PROPERTIES=dogshowpro=987654321

# ===== Dogshowpro (Supabase) =====
DOGSHOWPRO_SUPABASE_URL=https://vaorjdhqotocxqgrhxcr.supabase.co
# Service role-nyckel: läses ALDRIG av klienten, bara av den här servern. Verktygen returnerar enbart aggregat, ingen persondata.
DOGSHOWPRO_SUPABASE_SERVICE_ROLE_KEY=
