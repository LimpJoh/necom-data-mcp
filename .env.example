# Kommande: presentfabriken, woff, teeshop, skoltrojan, studentplaketet – kopiera ett block, lägg nyckeln i BRANDS.

# ============ Delade leverantörsnycklar ============
# Google (GA4 + Search Console): servicekonto-JSON läggs som /opt/necom-data-mcp/data/ga4-service-account.json
# Servicekontots e-post ska ha Läsare i GA4 per property och användare i Search Console per sajt.
STRIPE_SECRET_KEY=            # restricted key: Balance transactions read, Charges read
MOLLIE_ACCESS_TOKEN=          # organisationstoken: payments.read, profiles.read

# ============ Ops-lager (av som default) ============
OPS_ENABLED=false
OPS_GITHUB_TOKEN=             # fine-grained: Contents RW, Workflows RW, Actions R, Administration RW (för create repo)
OPS_GITHUB_OWNER=LimpJoh
OPS_SUPABASE_ACCESS_TOKEN=    # supabase.com/dashboard/account/tokens
OPS_SUPABASE_ORG_ID=
OPS_HOSTINGER_TOKEN=          # hPanel → API-token
OPS_VPS_IP=76.13.11.64
OPS_SSH_USER=deploy           # privat nyckel: /opt/necom-data-mcp/data/ops_ssh_key (chmod 600, ägare 10001)
