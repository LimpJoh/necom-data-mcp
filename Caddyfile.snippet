# Lägg till i din Caddyfile (och peka DNS A-post mcp.necom.se -> VPS:ens IP).
# Caddy ordnar TLS-certifikat automatiskt.

mcp.necom.se {
	encode gzip
	reverse_proxy 127.0.0.1:3006 {
		# SSE/streaming: stäng av buffring och låt långa svar leva
		flush_interval -1
		transport http {
			read_timeout 600s
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
